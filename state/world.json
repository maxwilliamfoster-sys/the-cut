  "laws": [
    {
      "id": "law01",
      "title": "Quiet Hours in the Empty Lot",
      "text": "No person may sit alone on the bench in the empty lot after midnight.",
      "keywords": [
        "empty lot",
        "cold bench",
        "sitting alone",
        "late night"
      ],
      "penalty": {
        "type": "service",
        "amount": 10
      },
      "proposed_by": "junie",
      "because": "Too many residents sitting alone on the cold bench all night.",
      "day_enacted": 264,
      "status": "enacted",
      "convictions": 0
    },
    {
      "id": "law02",
      "title": "Counter Glass Prohibition",
      "text": "No person shall leave an empty drinking glass unattended upon any public outdoor counter after snowfall begins.",
      "keywords": [
        "empty glass",
        "outdoor counter",
        "unattended cup",
        "snowfall"
      ],
      "penalty": {
        "type": "fine",
        "amount": 15
      },
      "proposed_by": "gus",
      "because": "Unattended glasses left on the counter in the cold.",
      "day_enacted": 269,
      "status": "enacted",
      "convictions": 1
    }
  ],
